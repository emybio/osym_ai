# =============================
#   ENV & SECRETS
# =============================

# Önce tüm env'leri ignore et
.env
.env.*
.envrc

# Ama development ve production env'lerini COMMIT ET
!.env.development
!.env.production

# Kişiye özel env ignore edilmeli
.env.local

# =============================
#   PYTHON / DJANGO
# =============================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.log
*.pid
db.sqlite3
media/
staticfiles/

# =============================
#   VIRTUAL ENVIRONMENTS
# =============================
env/
venv/
.venv/

# =============================
#   DOCKER FILES
# =============================
*.pid
*.seed
*.bak
*.backup
*.tar
*.gz

# =============================
