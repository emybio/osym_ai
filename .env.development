DJANGO_ENV=development
ENVIRONMENT=development
DEBUG=1

# Allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis (LOCAL)
REDIS_URL=redis://localhost:6379/0

# DB (local SQLite kullanacaksın, override yok)
# İstersen local Postgres için açabilirsin:
# POSTGRES_DB=osym
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=osym
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# AI keys (geçersiz olabilir)
OPENAI_API_KEY=xxx
ZAI_API_KEY=xxx
ANTHROPIC_API_KEY=xxx

IGNORE_SSL=False
USE_AI_API=True
