DJANGO_ENV=production
ENVIRONMENT=production
DEBUG=0

# Allowed hosts (kendi domain adreslerini yazabilirsin)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1

# Production DB (Docker veya gerçek sunucu)
POSTGRES_DB=osym
POSTGRES_USER=postgres
POSTGRES_PASSWORD=osym
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Production Redis
REDIS_URL=redis://redis:6379/0

# AI keys
OPENAI_API_KEY=xxx
ZAI_API_KEY=xxx
ANTHROPIC_API_KEY=xxx

IGNORE_SSL=True
USE_AI_API=True
